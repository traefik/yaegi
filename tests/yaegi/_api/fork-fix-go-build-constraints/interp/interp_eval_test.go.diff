+func TestEvalGoBuildConstraint(t *testing.T) {
+	i := interp.New(interp.Options{GoPath: filepath.FromSlash("testdata/gobuild")})
+
+	// Package foo contains files excluded only by a //go:build line (no legacy +build line):
+	// a "package main" file tagged "ignore", and a redeclaration of X behind an unset tag.
+	if _, err := i.Eval(`import "foo"`); err != nil {
+		t.Fatal(err)
+	}
+
+	runTests(t, i, []testCase{
+		{desc: "foo.X", src: "foo.X", res: "1"},
+	})
+}
